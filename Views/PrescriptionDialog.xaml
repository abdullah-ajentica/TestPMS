<Window x:Class="TestPms.Views.PrescriptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prescription"
        AutomationProperties.AutomationId="PrescriptionDialog"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="Add Prescription" FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Rx Number" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="RxNumberBox" AutomationProperties.AutomationId="uxRxNumberField" Height="28" Margin="0,0,0,10"/>

        <TextBlock Text="Patient Name" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="PatientNameBox" AutomationProperties.AutomationId="uxPatientNameField" Height="28" Margin="0,0,0,10"/>

        <TextBlock Text="Drug Name" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="DrugNameBox" AutomationProperties.AutomationId="uxDrugNameField" Height="28" Margin="0,0,0,10"/>

        <TextBlock Text="Quantity" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="QuantityBox" AutomationProperties.AutomationId="uxQuantityField" Height="28" Margin="0,0,0,10"/>

        <TextBlock Text="Prescriber" FontSize="12" Margin="0,0,0,4"/>
        <TextBox x:Name="PrescriberBox" AutomationProperties.AutomationId="uxPrescriberField" Height="28" Margin="0,0,0,10"/>

        <TextBlock Text="Date Written" FontSize="12" Margin="0,0,0,4"/>
        <DatePicker x:Name="DateWrittenPicker" AutomationProperties.AutomationId="uxDateWrittenField" Height="28" Margin="0,0,0,10"/>

        <TextBlock x:Name="ValidationError"
                   AutomationProperties.AutomationId="uxValidationError"
                   Text="Rx Number, Patient Name and Drug Name are required."
                   Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" AutomationProperties.AutomationId="uxCancelButton"
                    Content="Cancel" Width="90" Height="30" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" AutomationProperties.AutomationId="uxSaveButton"
                    Content="Save" Width="90" Height="30" Background="#2563EB" Foreground="White"
                    BorderThickness="0" Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
