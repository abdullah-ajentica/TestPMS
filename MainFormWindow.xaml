<Window x:Class="TestPms.MainFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TestPms.Views"
        AutomationProperties.AutomationId="MainForm"
        Title="TestPms" Height="768" Width="1366"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <views:MainFormView x:Name="MainForm"
                             LockRequested="MainForm_LockRequested"
                             ProcessRequested="MainForm_ProcessRequested"/>

        <Border x:Name="ToastBorder"
                AutomationProperties.AutomationId="uxSuccessToast"
                Background="#16A34A" CornerRadius="4" Padding="16,10"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,20,20,0" Visibility="Collapsed">
            <TextBlock x:Name="ToastText"
                       AutomationProperties.AutomationId="uxSuccessToastMessage"
                       Foreground="White" FontSize="13" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
