<Window x:Class="TestPms.LumistryWebpageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lumistry"
        AutomationProperties.AutomationId="LumistryWebpage"
        Width="1200" Height="800"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <wv2:WebView2 x:Name="Browser"
                   AutomationProperties.AutomationId="uxLumistryBrowser"
                   Source="https://lumistry.com/solutions/"/>
</Window>
